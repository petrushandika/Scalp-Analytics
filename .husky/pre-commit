#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Resolve paths (support both Backend/ and backend/)
REPO_ROOT=$(git rev-parse --show-toplevel)
BACKEND_DIR="$REPO_ROOT/Backend"
FRONTEND_DIR="$REPO_ROOT/Frontend"
[ -d "$REPO_ROOT/backend" ] && BACKEND_DIR="$REPO_ROOT/backend"
[ -d "$REPO_ROOT/frontend" ] && FRONTEND_DIR="$REPO_ROOT/frontend"

# Get list of staged files (relative to repo root)
STAGED_PYTHON=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' | head -20)
STAGED_TYPESCRIPT=$(git diff --cached --name-only --diff-filter=ACM | grep '\.[jt]sx\?$' | head -20)

# Backend checks
if [ -n "$STAGED_PYTHON" ]; then
  echo "🐍 Checking Python files..."

  cd "$BACKEND_DIR" || exit 1

  # Strip backend prefix from paths for ruff (it runs from backend dir)
  PYTHON_FILES=$(echo "$STAGED_PYTHON" | sed "s|^[Bb]ackend/||g")

  # Run ruff check
  echo "  Running ruff check..."
  ruff check $PYTHON_FILES
  if [ $? -ne 0 ]; then
    echo "❌ Ruff check failed"
    exit 1
  fi

  # Run ruff format check
  echo "  Running ruff format check..."
  ruff format --check $PYTHON_FILES
  if [ $? -ne 0 ]; then
    echo "❌ Ruff format check failed. Run 'ruff format .' to fix."
    exit 1
  fi

  cd "$REPO_ROOT"
fi

# Frontend checks
if [ -n "$STAGED_TYPESCRIPT" ]; then
  echo "📝 Checking TypeScript files..."

  cd "$FRONTEND_DIR" || exit 1

  # Run TypeScript check
  echo "  Running TypeScript check..."
  npm run typecheck
  if [ $? -ne 0 ]; then
    echo "❌ TypeScript check failed"
    exit 1
  fi

  cd "$REPO_ROOT"
fi

echo "✅ All pre-commit checks passed!"
